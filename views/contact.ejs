<%- include('partials/header') %><section class="page-hero compact"><div class="container"><span class="eyebrow eyebrow-accent">Customer support</span><h1>How can we help?</h1><p>Send a question or service-related message. It will be saved for administrator review.</p></div></section><section class="section"><div class="container contact-layout"><form class="form-card" method="post" novalidate><input type="hidden" name="_csrf" value="<%= csrf %>"><h2>Send a message</h2><div class="form-grid"><label class="field"><span>Full name <em>*</em></span><input name="name" value="<%= values.name||'' %>" required><% if(errors.name){ %><span class="field-error"><%= errors.name %></span><% } %></label><label class="field"><span>Email <em>*</em></span><input type="email" name="email" value="<%= values.email||'' %>" required><% if(errors.email){ %><span class="field-error"><%= errors.email %></span><% } %></label><label class="field full"><span>Mobile number</span><input name="phone" value="<%= values.phone||'' %>" inputmode="numeric" maxlength="10"><% if(errors.phone){ %><span class="field-error"><%= errors.phone %></span><% } %></label><label class="field full"><span>Subject <em>*</em></span><input name="subject" value="<%= values.subject||'' %>" required><% if(errors.subject){ %><span class="field-error"><%= errors.subject %></span><% } %></label><label class="field full"><span>Message <em>*</em></span><textarea name="message" rows="6" required><%= values.message||'' %></textarea><% if(errors.message){ %><span class="field-error"><%= errors.message %></span><% } %></label></div><button class="button" type="submit">Save message</button></form><aside class="contact-info"><span class="eyebrow">Business information</span><h2>FixMitra support</h2><div><small>Email</small><a href="mailto:<%= settings.business_email %>"><%= settings.business_email %></a></div><div><small>Phone</small><strong><%= settings.business_phone || 'Not configured' %></strong><span><%= settings.business_phone?'Call during operating hours.':'Phone support will appear after an administrator configures a real number.' %></span></div><div><small>Service area</small><strong><%= settings.service_area %></strong></div><div><small>Operating hours</small><strong><%= settings.operating_hours %></strong></div><div class="notice"><strong>Map unavailable</strong><span>No verified business address or map key is configured, so no map is displayed.</span></div></aside></div></section><%- include('partials/footer') %>