<%- include('partials/header') %><section class="section success-page"><div class="container narrow"><div class="success-card"><div class="success-icon">✓</div><span class="eyebrow eyebrow-accent">Request submitted</span><h1>Your booking request is now New.</h1><p>An administrator will review the details before confirming the appointment. Save your reference and registered mobile number.</p><div class="reference-box"><small>Booking reference</small><strong><%= booking.reference %></strong><button type="button" class="copy-button" data-copy="<%= booking.reference %>">Copy</button></div><div class="summary-grid"><div><span>Service</span><strong><%= booking.service_name %></strong></div><div><span>Current status</span><strong class="status-badge <%= h.statusClass(booking.status) %>"><%= booking.status %></strong></div><div><span>Preferred appointment</span><strong><%= h.formatDate(booking.appointment_date) %> at <%= booking.appointment_time %></strong></div><div><span>Customer</span><strong><%= booking.customer_name %></strong></div></div><div class="notice"><strong>Not yet confirmed</strong><span>Submission records your request; it does not guarantee technician availability or a final price.</span></div><div class="success-actions"><a class="button" href="/track">Track booking</a><a class="button button-ghost" href="/services">Explore services</a></div></div></div></section><%- include('partials/footer') %>