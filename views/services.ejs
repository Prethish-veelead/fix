<%- include('partials/header') %><section class="page-hero"><div class="container"><span class="eyebrow eyebrow-accent">Service directory</span><h1>Professional care for every corner of your home</h1><p>Search specialists, compare inclusions and start with a clear illustrative price.</p></div></section><section class="section"><div class="container"><form class="filter-bar" method="get"><label class="search-field"><span class="sr-only">Search services</span><input type="search" name="q" value="<%= q %>" placeholder="Search services or problems…"></label><label><span class="sr-only">Category</span><select name="category"><option value="">All categories</option><% categories.forEach(c=>{ %><option value="<%= c.slug %>" <%= category===c.slug?'selected':'' %>><%= c.name %></option><% }) %></select></label><button class="button" type="submit">Search</button><% if(q||category){ %><a class="button button-ghost" href="/services">Clear</a><% } %></form><div class="result-count"><strong><%= services.length %></strong> available service<%= services.length===1?'':'s' %></div><% if(services.length){ %><div class="service-grid"><% services.forEach(service=>{ %><%- include('partials/service-card',{service}) %><% }) %></div><% } else { %><div class="empty-state"><span>⌕</span><h2>No matching services</h2><p>Try a broader search or choose another category.</p><a class="button" href="/services">View every service</a></div><% } %></div></section><%- include('partials/footer') %>