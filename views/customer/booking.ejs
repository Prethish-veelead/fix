<%- include('../partials/header') %><section class="page-hero compact"><div class="container"><a class="back-link light-link" href="/dashboard">← Customer dashboard</a><span class="eyebrow eyebrow-accent">Booking <%= booking.reference %></span><h1><%= booking.service_name %></h1><p>Created <%= h.formatDateTime(booking.created_at) %></p></div></section><section class="section"><div class="container detail-content"><div><article class="content-card"><div class="tracking-head"><div><span class="eyebrow">Current status</span><h2>Service overview</h2></div><span class="status-badge <%= h.statusClass(booking.status) %>"><%= booking.status %></span></div><div class="tracking-grid"><div><span>Preferred appointment</span><strong><%= h.formatDate(booking.appointment_date) %>, <%= booking.appointment_time %></strong></div><div><span>Technician</span><strong><%= booking.technician_name||'Awaiting assignment' %></strong></div><div><span>Quotation</span><strong><%= booking.quotation_total!=null?h.formatINR(booking.quotation_total):'Not available' %></strong><small><%= booking.quotation_total!=null?'Estimate—not a payment receipt':'' %></small></div><div><span>Address</span><strong><%= booking.building %>, <%= booking.city %></strong></div></div><h3>Problem description</h3><p><%= booking.problem %></p></article><article class="content-card"><h2>Status history</h2><ol class="timeline"><% history.forEach((item,i)=>{ %><li class="<%= i===history.length-1?'current':'' %>"><span></span><div><strong><%= item.status %></strong><small><%= h.formatDateTime(item.created_at) %></small><p><%= item.note||'' %></p></div></li><% }) %></ol></article><% if(booking.status==='Completed'){ %><article class="content-card"><h2>Your feedback</h2><p>Feedback is moderated before it can appear publicly.</p><form method="post" action="/dashboard/bookings/<%= booking.id %>/review"><input type="hidden" name="_csrf" value="<%= csrf %>"><label class="field"><span>Rating</span><select name="rating" required><% [5,4,3,2,1].forEach(x=>{ %><option value="<%= x %>" <%= review&&review.rating===x?'selected':'' %>><%= '★'.repeat(x) %> <%= x %>/5</option><% }) %></select></label><label class="field"><span>Comments</span><textarea name="comment" rows="4" minlength="10" required><%= review?review.comment:'' %></textarea></label><button class="button" type="submit"><%= review?'Update feedback':'Submit feedback' %></button><% if(review){ %><span class="status-badge <%= review.published?'status-completed':'status-quoted' %>"><%= review.published?'Published':'Awaiting moderation' %></span><% } %></form></article><% } %></div><aside class="sticky-card"><span class="eyebrow">Need assistance?</span><h3>Contact support</h3><p>Include your booking reference so the team can locate the request quickly.</p><a class="button button-block" href="/contact">Contact FixMitra</a><a class="button button-block button-ghost" href="/track">Open public tracker</a></aside></div></section><%- include('../partials/footer') %>