<%- include('../partials/header') %><section class="page-hero compact"><div class="container"><a class="back-link light-link" href="/dashboard">← Customer dashboard</a><span class="eyebrow eyebrow-accent">Account settings</span><h1>Profile & security</h1><p>Keep your booking contact and address details current.</p></div></section><section class="section"><div class="container settings-grid"><form class="form-card" method="post"><input type="hidden" name="_csrf" value="<%= csrf %>"><h2>Profile information</h2><div class="form-grid"><label class="field"><span>Full name</span><input name="name" value="<%= profile.name||'' %>" required><% if(errors.name){ %><span class="field-error"><%= errors.name %></span><% } %></label><label class="field"><span>Email</span><input value="<%= profile.email %>" disabled><small>Email changes require administrator support.</small></label><label class="field"><span>Mobile number</span><input name="phone" value="<%= profile.phone||'' %>" maxlength="10" required><% if(errors.phone){ %><span class="field-error"><%= errors.phone %></span><% } %></label><label class="field"><span>House or building</span><input name="building" value="<%= profile.building||'' %>"></label><label class="field full"><span>Street</span><input name="street" value="<%= profile.street||'' %>"></label><label class="field"><span>City</span><input name="city" value="<%= profile.city||'' %>"></label><label class="field"><span>State</span><input name="state" value="<%= profile.state||'' %>"></label><label class="field"><span>PIN code</span><input name="pincode" value="<%= profile.pincode||'' %>" maxlength="6"><% if(errors.pincode){ %><span class="field-error"><%= errors.pincode %></span><% } %></label></div><button class="button" type="submit">Save profile</button></form><form class="form-card" method="post" action="/dashboard/password"><input type="hidden" name="_csrf" value="<%= csrf %>"><h2>Change password</h2><p>Use a unique password with at least 10 characters.</p><label class="field"><span>Current password</span><input type="password" name="current_password" autocomplete="current-password" required></label><label class="field"><span>New password</span><input type="password" name="new_password" minlength="10" autocomplete="new-password" required></label><button class="button" type="submit">Change password</button></form></div></section><%- include('../partials/footer') %>