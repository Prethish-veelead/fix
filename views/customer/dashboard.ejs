<%- include('../partials/header') %><section class="dashboard-hero"><div class="container dashboard-welcome"><div><span class="eyebrow eyebrow-accent">Customer dashboard</span><h1>Welcome back, <%= user.name.split(' ')[0] %>.</h1><p>Manage requests, appointments and service updates in one place.</p></div><a class="button button-light" href="/book">+ Book a service</a></div></section><section class="section dashboard-section"><div class="container"><div class="kpi-grid customer-kpis"><article><span class="kpi-icon">▣</span><div><small>Total bookings</small><strong><%= stats.total||0 %></strong></div></article><article><span class="kpi-icon teal">↻</span><div><small>Active bookings</small><strong><%= stats.active||0 %></strong></div></article><article><span class="kpi-icon green">✓</span><div><small>Completed</small><strong><%= stats.completed||0 %></strong></div></article><article><span class="kpi-icon gold">◷</span><div><small>Upcoming</small><strong><%= bookings.filter(b=>!['Completed','Cancelled'].includes(b.status)).length %></strong></div></article></div><div class="dashboard-grid"><section class="panel"><div class="panel-head"><div><h2>Recent service requests</h2><p>Your latest bookings and status updates.</p></div></div><% if(bookings.length){ %><div class="table-wrap"><table><thead><tr><th>Booking</th><th>Service</th><th>Appointment</th><th>Quotation</th><th>Status</th><th></th></tr></thead><tbody><% bookings.forEach(b=>{ %><tr><td><strong><%= b.reference %></strong><small><%= h.formatDate(b.created_at) %></small></td><td><%= b.service_name %></td><td><%= h.formatDate(b.appointment_date) %><small><%= b.appointment_time %></small></td><td><%= b.quotation_total!=null?h.formatINR(b.quotation_total):'—' %></td><td><span class="status-badge <%= h.statusClass(b.status) %>"><%= b.status %></span></td><td><a class="icon-button" href="/dashboard/bookings/<%= b.id %>" aria-label="View booking">→</a></td></tr><% }) %></tbody></table></div><% }else{ %><div class="empty-state small"><span>▣</span><h3>No bookings yet</h3><p>Your service requests will appear here.</p><a class="button" href="/book">Book a service</a></div><% } %></section><aside class="panel notifications-panel"><div class="panel-head"><div><h2>Updates</h2><p>In-app notifications</p></div></div><% if(notifications.length){ %><div class="notification-list"><% notifications.forEach(n=>{ %><div><span></span><div><strong><%= n.title %></strong><p><%= n.message %></p><small><%= h.formatDateTime(n.created_at) %></small></div></div><% }) %></div><% }else{ %><p class="muted">No notifications yet.</p><% } %><hr><a class="text-link" href="/dashboard/profile">Manage profile settings →</a></aside></div></div></section><%- include('../partials/footer') %>