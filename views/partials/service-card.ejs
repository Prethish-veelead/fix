<article class="service-card"><a class="service-image" href="/services/<%= service.slug %>"><img src="<%= service.image %>" alt="<%= service.name %> professional service" loading="lazy" width="560" height="360"><span class="price-pill">From <%= h.formatINR(service.starting_price) %></span></a><div class="service-card-body"><span class="eyebrow"><%= service.category_name || '' %></span><h3><a href="/services/<%= service.slug %>"><%= service.name %></a></h3><p><%= service.description %></p><div class="service-meta"><span>◷ <%= service.duration %></span><span>Illustrative price</span></div><div class="card-actions"><a class="text-link" href="/services/<%= service.slug %>">View details →</a><a class="button button-sm button-outline" href="/book?service=<%= service.id %>">Book now</a></div></div></article>
