<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="description" content="FixMitra makes professional home service booking and tracking simple."><meta name="theme-color" content="#101D35"><title><%= title %> · FixMitra</title><link rel="icon" href="/images/favicon.svg" type="image/svg+xml"><link rel="stylesheet" href="/css/app.css"></head><body>
<a class="skip-link" href="#main">Skip to content</a>
<header class="site-header"><div class="container nav-wrap"><a class="brand" href="/" aria-label="FixMitra home"><span class="brand-mark">F</span><span>Fix<span>Mitra</span></span></a><button class="nav-toggle" type="button" aria-controls="main-nav" aria-expanded="false"><span></span><span></span><span></span><span class="sr-only">Open menu</span></button><nav id="main-nav" class="main-nav" aria-label="Main navigation"><a class="<%= path==='/'?'active':'' %>" href="/">Home</a><a class="<%= path.startsWith('/services')?'active':'' %>" href="/services">Services</a><a href="/#how-it-works">How It Works</a><a class="<%= path==='/about'?'active':'' %>" href="/about">About</a><a class="<%= path==='/contact'?'active':'' %>" href="/contact">Contact</a><% if(user && user.role==='customer'){ %><a href="/dashboard">Dashboard</a><form method="post" action="/logout" class="nav-form"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="link-button">Logout</button></form><% } else if(user && user.role==='admin'){ %><a href="/admin">Admin</a><form method="post" action="/logout" class="nav-form"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="link-button">Logout</button></form><% } else { %><a href="/login">Login</a><a href="/register">Register</a><% } %><a class="button button-sm" href="/book">Book a Service</a></nav></div></header>
<% if(flash){ %><div class="toast toast-<%= flash.type %>" role="status"><%= flash.message %><button type="button" aria-label="Dismiss">×</button></div><% } %>
<main id="main">
