<%- include('partials/header') %><section class="page-hero"><div class="container"><span class="eyebrow eyebrow-accent">Secure request tracking</span><h1>Know exactly where your service stands</h1><p>Enter the booking reference and registered mobile number. Both must match.</p></div></section><section class="section"><div class="container track-layout"><div><form class="track-form" method="post"><input type="hidden" name="_csrf" value="<%= csrf %>"><h2>Track a booking</h2><label class="field"><span>Booking reference</span><input name="reference" value="<%= values.reference||'' %>" placeholder="FM-2026-XXXXXXXX" required autocomplete="off"></label><label class="field"><span>Registered mobile number</span><input name="phone" value="<%= values.phone||'' %>" inputmode="numeric" maxlength="10" placeholder="10-digit number" required autocomplete="tel"></label><% if(error){ %><div class="form-error-banner"><%= error %></div><% } %><button class="button button-block" type="submit">Track status</button><p class="form-footnote">For privacy, no booking data is shown unless both values match.</p></form></div><div><% if(booking){ %><article class="tracking-card"><div class="tracking-head"><div><span class="eyebrow">Booking <%= booking.reference %></span><h2><%= booking.service_name %></h2><p>Requested on <%= h.formatDate(booking.created_at) %></p></div><span class="status-badge <%= h.statusClass(booking.status) %>"><%= booking.status %></span></div><div class="tracking-grid"><div><span>Preferred appointment</span><strong><%= h.formatDate(booking.appointment_date) %>, <%= booking.appointment_time %></strong></div><div><span>Assigned technician</span><strong><%= booking.technician_name || 'Awaiting assignment' %></strong></div><div><span>Estimated quotation</span><strong><%= booking.quotation_total!=null?h.formatINR(booking.quotation_total):'Not available yet' %></strong><small><%= booking.quotation_total!=null?'Estimate—not a payment receipt':'' %></small></div><div><span>Service location</span><strong><%= booking.city %>, <%= booking.state %></strong></div></div><h3>Status history</h3><ol class="timeline"><% history.forEach((item,i)=>{ %><li class="<%= i===history.length-1?'current':'' %>"><span></span><div><strong><%= item.status %></strong><small><%= h.formatDateTime(item.created_at) %></small><p><%= item.note||'' %></p></div></li><% }) %></ol></article><% } else { %><div class="tracking-placeholder"><span>↻</span><h2>Your service timeline will appear here</h2><p>Track assignment, quotation and status changes from New through completion.</p><div class="mini-timeline"><i class="done"></i><i></i><i></i><i></i></div></div><% } %></div></div></section><%- include('partials/footer') %>