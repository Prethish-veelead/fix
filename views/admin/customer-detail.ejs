<%- include('../partials/admin-header') %><a class="back-link" href="/admin/customers">← All customers</a><div class="admin-detail-head"><div><span class="eyebrow"><%= customer.is_demo?'Demonstration customer':'Customer profile' %></span><h2><%= customer.name %></h2><p>Joined <%= h.formatDate(customer.created_at) %></p></div><span class="status-badge <%= customer.active?'status-completed':'status-cancelled' %>"><%= customer.active?'Active':'Inactive' %></span></div><div class="admin-detail-grid"><div><section class="panel"><div class="panel-head"><div><h2>Booking history</h2><p><%= bookings.length %> linked service requests</p></div></div><div class="table-wrap"><table><thead><tr><th>Booking</th><th>Service</th><th>Appointment</th><th>Quotation</th><th>Status</th><th></th></tr></thead><tbody><% bookings.forEach(b=>{ %><tr><td><strong><%= b.reference %></strong><small><%= h.formatDate(b.created_at) %></small></td><td><%= b.service_name %></td><td><%= h.formatDate(b.appointment_date) %>, <%= b.appointment_time %></td><td><%= b.total!=null?h.formatINR(b.total):'—' %></td><td><span class="status-badge <%= h.statusClass(b.status) %>"><%= b.status %></span></td><td><a class="icon-button" href="/admin/bookings/<%= b.id %>">→</a></td></tr><% }) %><% if(!bookings.length){ %><tr><td colspan="6">No bookings linked to this customer.</td></tr><% } %></tbody></table></div></section></div><aside><section class="panel form-stack"><h2>Contact details</h2><div class="info-list"><div><span>Email</span><strong><%= customer.email %></strong></div><div><span>Mobile</span><strong><%= customer.phone||'Not provided' %></strong></div><div><span>Address</span><strong><%= [customer.building,customer.street,customer.city,customer.state,customer.pincode].filter(Boolean).join(', ')||'Not provided' %></strong></div></div><div class="card-actions"><a class="button button-xs button-outline" href="mailto:<%= customer.email %>">Email</a><% if(customer.phone){ %><a class="button button-xs button-outline" href="tel:<%= customer.phone %>">Call</a><% } %></div></section><form class="panel form-stack confirm-form" method="post" action="/admin/customers/<%= customer.id %>/toggle" data-confirm="Change this customer's account status?"><input type="hidden" name="_csrf" value="<%= csrf %>"><h2>Account status</h2><p>Inactive customers cannot sign in. Existing operational records are preserved.</p><button class="button <%= customer.active?'button-danger':'button-outline' %>" type="submit"><%= customer.active?'Deactivate':'Activate' %> customer</button></form></aside></div><%- include('../partials/admin-footer') %>