<%- include('../partials/admin-header') %><div class="admin-intro"><p>Manage illustrative starting prices, inspection fees and discounts. Changes publish to public service pages.</p><span class="demo-label">All values in INR</span></div><div class="notice admin-notice"><strong>Quotation policy</strong><span>Final quotations may vary with actual scope. These values are never presented as collected revenue.</span></div><section class="panel"><div class="table-wrap"><table><thead><tr><th>Service</th><th>Starting price</th><th>Inspection fee</th><th>Discount %</th><th>Public status</th><th></th></tr></thead><tbody><% services.forEach(s=>{ %><tr><td><strong><%= s.name %></strong><small><%= s.category_name %></small></td><form method="post" action="/admin/pricing/<%= s.id %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><td><input class="table-input" type="number" name="starting_price" min="0" value="<%= s.starting_price %>"></td><td><input class="table-input" type="number" name="inspection_fee" min="0" value="<%= s.inspection_fee %>"></td><td><input class="table-input" type="number" name="discount_percent" min="0" max="100" value="<%= s.discount_percent %>"></td><td><span class="status-badge <%= s.active?'status-completed':'status-cancelled' %>"><%= s.active?'Enabled':'Disabled' %></span></td><td><button class="button button-xs button-outline" type="submit">Save</button></td></form></tr><% }) %></tbody></table></div></section><%- include('../partials/admin-footer') %>