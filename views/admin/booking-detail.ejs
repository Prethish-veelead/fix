<%- include('../partials/admin-header') %><a class="back-link" href="/admin/bookings">← All bookings</a><div class="admin-detail-head"><div><span class="eyebrow">Booking <%= booking.reference %> <%= booking.is_demo?'· Demo record':'' %></span><h2><%= booking.service_name %></h2><p>Created <%= h.formatDateTime(booking.created_at) %></p></div><span class="status-badge large <%= h.statusClass(booking.status) %>"><%= booking.status %></span></div><div class="admin-detail-grid"><div><section class="panel"><div class="panel-head"><div><h2>Customer & service information</h2><p>Complete request details</p></div></div><div class="info-grid"><div><span>Customer</span><strong><%= booking.customer_name %></strong></div><div><span>Mobile</span><strong><%= booking.phone %></strong></div><div><span>Email</span><strong><%= booking.email||'Not provided' %></strong></div><div><span>Preferred appointment</span><strong><%= h.formatDate(booking.appointment_date) %>, <%= booking.appointment_time %></strong></div><div class="full"><span>Address</span><strong><%= booking.building %>, <%= booking.street %>, <%= booking.city %>, <%= booking.state %> – <%= booking.pincode %></strong></div><div class="full"><span>Problem description</span><p><%= booking.problem %></p><div class="inline-actions"><a class="button button-xs button-outline" href="tel:<%= booking.phone %>">Call customer</a><% if(booking.email){ %><a class="button button-xs button-outline" href="mailto:<%= booking.email %>?subject=FixMitra%20<%= booking.reference %>">Email customer</a><% } %></div></div></div></section><section class="panel"><div class="panel-head"><div><h2>Status history</h2><p>Persistent audit timeline</p></div></div><ol class="timeline"><% history.forEach((item,i)=>{ %><li class="<%= i===0?'current':'' %>"><span></span><div><strong><%= item.status %></strong><small><%= h.formatDateTime(item.created_at) %> <%= item.changed_by_name?'· '+item.changed_by_name:'' %></small><p><%= item.note||'' %></p></div></li><% }) %></ol></section></div><aside><form class="panel form-stack" method="post" action="/admin/bookings/<%= booking.id %>/update"><input type="hidden" name="_csrf" value="<%= csrf %>"><h2>Manage booking</h2><div class="form-grid"><label class="field"><span>Appointment date</span><input type="date" name="appointment_date" value="<%= booking.appointment_date %>"></label><label class="field"><span>Appointment time</span><input type="time" name="appointment_time" value="<%= booking.appointment_time %>"></label><label class="field full"><span>Problem description</span><textarea name="problem" rows="3"><%= booking.problem %></textarea></label></div><label class="field"><span>Status</span><select name="status"><% statuses.forEach(x=>{ %><option <%= booking.status===x?'selected':'' %>><%= x %></option><% }) %></select></label><label class="field"><span>Assign active technician</span><select name="technician_id"><option value="">Unassigned</option><% technicians.forEach(t=>{ %><option value="<%= t.id %>" <%= booking.technician_id===t.id?'selected':'' %>><%= t.name %> · <%= t.specialization %></option><% }) %></select></label><label class="field"><span>Status note</span><input name="status_note" placeholder="Reason for this update"></label><label class="field"><span>Internal notes</span><textarea name="internal_notes" rows="4"><%= booking.internal_notes||'' %></textarea><small>Visible to administrators only.</small></label><button class="button button-block" type="submit">Save booking changes</button></form><form class="panel form-stack quote-calculator" method="post" action="/admin/bookings/<%= booking.id %>/quotation"><input type="hidden" name="_csrf" value="<%= csrf %>"><h2>Quotation</h2><p>Estimated values—not payment collection.</p><label class="field"><span>Labour charges</span><input type="number" name="labour" min="0" value="<%= booking.labour||0 %>"></label><label class="field"><span>Material charges</span><input type="number" name="materials" min="0" value="<%= booking.materials||0 %>"></label><label class="field"><span>Additional charges</span><input type="number" name="additional" min="0" value="<%= booking.additional||0 %>"></label><label class="field"><span>Discount</span><input type="number" name="discount" min="0" value="<%= booking.discount||0 %>"></label><div class="quote-total"><span>Estimated total</span><strong><%= h.formatINR(booking.total||0) %></strong></div><label class="field"><span>Quotation status</span><select name="quotation_status"><% ['Draft','Sent','Accepted','Declined'].forEach(x=>{ %><option <%= booking.quotation_status===x?'selected':'' %>><%= x %></option><% }) %></select></label><label class="field"><span>Notes</span><textarea name="quotation_notes" rows="3"><%= booking.quotation_notes||'' %></textarea></label><button class="button button-block" type="submit">Save quotation</button></form><form class="panel danger-panel confirm-form" method="post" action="/admin/bookings/<%= booking.id %>/cancel" data-confirm="Cancel this booking? The change will be recorded in status history."><input type="hidden" name="_csrf" value="<%= csrf %>"><h3>Cancel booking</h3><input name="reason" placeholder="Cancellation reason"><button class="button button-danger button-block" type="submit" <%= booking.status==='Cancelled'?'disabled':'' %>>Cancel booking</button></form></aside></div><%- include('../partials/admin-footer') %>