<%- include('../partials/admin-header') %><div class="admin-intro"><p>Review customer contact information and booking activity without exposing password or session data.</p></div><form class="admin-filters"><input type="search" name="q" value="<%= q %>" placeholder="Name, email or phone…"><select name="active"><option value="">All accounts</option><option value="1" <%= active==='1'?'selected':'' %>>Active</option><option value="0" <%= active==='0'?'selected':'' %>>Inactive</option></select><button class="button" type="submit">Apply</button><a class="button button-ghost" href="/admin/customers">Clear</a></form><section class="panel"><div class="table-wrap"><table><thead><tr><th>Customer</th><th>Contact</th><th>Location</th><th>Bookings</th><th>Completed</th><th>Status</th><th></th></tr></thead><tbody><% customers.forEach(c=>{ %><tr><td><div class="customer-cell"><span class="avatar"><%= c.name.charAt(0) %></span><div><strong><a class="text-link" href="/admin/customers/<%= c.id %>"><%= c.name %></a></strong><small>Joined <%= h.formatDate(c.created_at) %> <%= c.is_demo?'· Demo':'' %></small></div></div></td><td><%= c.email %><small><%= c.phone||'No phone' %></small></td><td><%= c.city||'—' %>, <%= c.state||'—' %></td><td><%= c.bookings %></td><td><%= c.completed||0 %></td><td><span class="status-badge <%= c.active?'status-completed':'status-cancelled' %>"><%= c.active?'Active':'Inactive' %></span></td><td><form method="post" action="/admin/customers/<%= c.id %>/toggle" class="confirm-form" data-confirm="Change this customer's account status?"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="button button-xs <%= c.active?'button-danger':'button-outline' %>" type="submit"><%= c.active?'Deactivate':'Activate' %></button></form></td></tr><% }) %></tbody></table></div></section><%- include('../partials/admin-footer') %>