<%- include('../partials/admin-header') %><div class="admin-intro"><p>Public service cards update immediately when names, descriptions, prices, images or availability change.</p><div><button class="button button-outline" type="button" data-dialog-open="category-dialog">+ Category</button> <button class="button" type="button" data-dialog-open="service-dialog">+ Service</button></div></div><section class="panel"><div class="panel-head"><div><h2>Service catalogue</h2><p><%= services.length %> services across <%= categories.length %> categories</p></div></div><div class="table-wrap"><table><thead><tr><th>Service</th><th>Category</th><th>Duration</th><th>Starting price</th><th>Availability</th><th>Actions</th></tr></thead><tbody><% services.forEach(s=>{ %><tr><td><div class="table-service"><img src="<%= s.image %>" alt="" width="56" height="42"><div><strong><%= s.name %></strong><small>/<%= s.slug %> <%= s.is_demo?'· Demo seed':'' %></small></div></div></td><td><%= s.category_name %></td><td><%= s.duration %></td><td><%= h.formatINR(s.starting_price) %></td><td><span class="status-badge <%= s.active?'status-completed':'status-cancelled' %>"><%= s.active?'Active':'Inactive' %></span></td><td><div class="inline-actions"><button class="button button-xs button-outline" type="button" data-dialog-open="service-dialog" data-edit-service="<%= encodeURIComponent(JSON.stringify(s)) %>">Edit</button><form method="post" action="/admin/services/<%= s.id %>/toggle"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="button button-xs <%= s.active?'button-danger':'button-outline' %>" type="submit"><%= s.active?'Disable':'Enable' %></button></form></div></td></tr><% }) %></tbody></table></div></section><section class="panel category-admin"><div class="panel-head"><div><h2>Service categories</h2><p>Edit labels, descriptions, order and public visibility.</p></div></div><div class="category-edit-grid"><% categories.forEach(c=>{ %><form method="post" action="/admin/categories/<%= c.id %>/save" class="category-edit"><input type="hidden" name="_csrf" value="<%= csrf %>"><div><span class="status-badge <%= c.active?'status-completed':'status-cancelled' %>"><%= c.active?'Active':'Hidden' %></span><input name="name" value="<%= c.name %>" required></div><input name="description" value="<%= c.description %>"><input type="number" name="sort_order" min="0" value="<%= c.sort_order %>" aria-label="Sort order"><button class="button button-xs button-outline" type="submit">Save</button><button class="button button-xs <%= c.active?'button-danger':'button-outline' %>" type="submit" formaction="/admin/categories/<%= c.id %>/toggle"><%= c.active?'Hide':'Show' %></button></form><% }) %></div></section><dialog id="service-dialog" class="modal wide"><form method="dialog" class="modal-close"><button aria-label="Close">×</button></form><form method="post" action="/admin/services/save" enctype="multipart/form-data" class="form-stack modal-form"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="id"><h2>Add service</h2><div class="form-grid"><label class="field"><span>Name</span><input name="name" required></label><label class="field"><span>Slug</span><input name="slug" placeholder="generated-from-name"></label><label class="field"><span>Category</span><select name="category_id" required><% categories.forEach(c=>{ %><option value="<%= c.id %>"><%= c.name %></option><% }) %></select></label><label class="field"><span>Starting price (₹)</span><input type="number" name="starting_price" min="0" value="0" required></label><label class="field"><span>Estimated duration</span><input name="duration" placeholder="60–90 min" required></label><label class="field"><span>Service image</span><input type="file" name="image" accept="image/jpeg,image/png,image/webp"><small>JPG, PNG or WebP; max 2 MB.</small></label><label class="field full"><span>Description</span><textarea name="description" rows="3" required></textarea></label><label class="field full"><span>Inclusions</span><input name="inclusions" placeholder="Inspection|Basic repair|Cleanup"><small>Separate items with |</small></label><label class="field full"><span>Customer instructions</span><textarea name="instructions" rows="3"></textarea></label></div><button class="button" type="submit">Save service</button></form></dialog><dialog id="category-dialog" class="modal"><form method="dialog" class="modal-close"><button aria-label="Close">×</button></form><form method="post" action="/admin/categories/save" class="form-stack modal-form"><input type="hidden" name="_csrf" value="<%= csrf %>"><h2>Add service category</h2><label class="field"><span>Name</span><input name="name" required></label><label class="field"><span>Slug</span><input name="slug"></label><label class="field"><span>Description</span><textarea name="description" rows="3"></textarea></label><button class="button" type="submit">Create category</button></form></dialog><%- include('../partials/admin-footer') %>