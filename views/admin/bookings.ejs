<%- include('../partials/admin-header') %><div class="admin-intro"><p>Search, filter and manage every customer request. Results are paginated for performance.</p><a class="button button-outline" href="/admin/bookings/export.csv">Export CSV</a></div><form class="admin-filters"><label><span class="sr-only">Search</span><input type="search" name="q" value="<%= filters.q %>" placeholder="Booking ID or customer…"></label><select name="status"><option value="">All statuses</option><% statuses.forEach(x=>{ %><option <%= filters.status===x?'selected':'' %>><%= x %></option><% }) %></select><select name="service"><option value="">All services</option><% services.forEach(s=>{ %><option value="<%= s.id %>" <%= Number(filters.service)===s.id?'selected':'' %>><%= s.name %></option><% }) %></select><input type="date" name="date" value="<%= filters.date %>"><button class="button" type="submit">Apply filters</button><a class="button button-ghost" href="/admin/bookings">Clear</a></form><section class="panel"><div class="panel-head"><div><h2><%= p.total %> booking<%= p.total===1?'':'s' %></h2><p>Page <%= p.page %> of <%= p.pages %></p></div></div><div class="table-wrap"><table><thead><tr><th>Booking ID</th><th>Customer</th><th>Service</th><th>Requested date</th><th>Technician</th><th>Quotation</th><th>Status</th><th>Action</th></tr></thead><tbody><% bookings.forEach(b=>{ %><tr><td><strong><%= b.reference %></strong><small><%= b.is_demo?'Demo record':h.formatDate(b.created_at) %></small></td><td><%= b.customer_name %><small><%= b.phone %></small></td><td><%= b.service_name %></td><td><%= h.formatDate(b.appointment_date) %><small><%= b.appointment_time %></small></td><td><%= b.technician_name||'Unassigned' %></td><td><%= b.total!=null?h.formatINR(b.total):'—' %></td><td><span class="status-badge <%= h.statusClass(b.status) %>"><%= b.status %></span></td><td><a class="button button-xs button-outline" href="/admin/bookings/<%= b.id %>">Manage</a></td></tr><% }) %><% if(!bookings.length){ %><tr><td colspan="8"><div class="empty-state small"><span>⌕</span><h3>No matching bookings</h3><p>Clear filters or try another search.</p></div></td></tr><% } %></tbody></table></div><% if(p.pages>1){ %><nav class="pagination" aria-label="Bookings pages"><% for(let i=1;i<=p.pages;i++){ %><a class="<%= i===p.page?'active':'' %>" href="?q=<%= encodeURIComponent(filters.q) %>&status=<%= encodeURIComponent(filters.status) %>&service=<%= filters.service %>&date=<%= filters.date %>&page=<%= i %>"><%= i %></a><% } %></nav><% } %></section><%- include('../partials/admin-footer') %>