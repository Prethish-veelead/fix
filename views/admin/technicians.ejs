<%- include('../partials/admin-header') %><div class="admin-intro"><p>Manage service professionals, availability and active account status. Inactive technicians cannot be assigned.</p><button class="button" type="button" data-dialog-open="tech-dialog">+ Add technician</button></div><form class="admin-filters"><input type="search" name="q" value="<%= q %>" placeholder="Search name or specialization…"><button class="button" type="submit">Search</button><a class="button button-ghost" href="/admin/technicians">Clear</a></form><div class="tech-admin-grid"><% techs.forEach(t=>{ %><article class="tech-admin-card"><div class="tech-admin-head"><img src="<%= t.image||'/images/technician-1.svg' %>" alt="" width="64" height="64"><div><span class="status-badge <%= t.active?'status-completed':'status-cancelled' %>"><%= t.active?'Active':'Inactive' %></span><h2><%= t.name %></h2><p><%= t.specialization %></p></div></div><dl><div><dt>Experience</dt><dd><%= t.experience %> years</dd></div><div><dt>Availability</dt><dd><%= t.availability %></dd></div><div><dt>Service area</dt><dd><%= t.service_areas %></dd></div><div><dt>Workload</dt><dd><%= t.workload %> bookings</dd></div><div><dt>Completed jobs</dt><dd><%= t.completed_jobs %></dd></div><div><dt>Contact</dt><dd><%= t.email %><br><%= t.phone %></dd></div></dl><div class="card-actions"><button class="button button-xs button-outline" type="button" data-dialog-open="tech-dialog" data-edit-tech="<%= encodeURIComponent(JSON.stringify(t)) %>">Edit</button><form method="post" action="/admin/technicians/<%= t.id %>/toggle"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="button button-xs <%= t.active?'button-danger':'button-outline' %>" type="submit"><%= t.active?'Deactivate':'Activate' %></button></form></div><% if(t.is_demo){ %><span class="demo-label">Demo profile</span><% } %></article><% }) %></div><dialog id="tech-dialog" class="modal"><form method="dialog" class="modal-close"><button aria-label="Close">×</button></form><form method="post" action="/admin/technicians/save" class="form-stack modal-form"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="id"><h2>Add technician</h2><label class="field"><span>Full name</span><input name="name" required></label><div class="form-grid"><label class="field"><span>Mobile number</span><input name="phone" maxlength="10" required></label><label class="field"><span>Email</span><input type="email" name="email" required></label><label class="field"><span>Specialization</span><input name="specialization" required></label><label class="field"><span>Experience (years)</span><input type="number" name="experience" min="0" value="0"></label><label class="field"><span>Service areas</span><input name="service_areas" value="Around Turkey"></label><label class="field"><span>Availability</span><select name="availability"><option>Available</option><option>Busy</option><option>On leave</option></select></label></div><button class="button" type="submit">Save technician</button></form></dialog><%- include('../partials/admin-footer') %>