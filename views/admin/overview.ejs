<%- include('../partials/admin-header') %><div class="admin-intro"><div><p>Live operational data from the FixMitra database. Seeded records are labelled as demonstration data.</p></div><a class="button" href="/admin/bookings">Manage bookings</a></div><div class="kpi-grid admin-kpis"><article><span class="kpi-icon">▣</span><div><small>Total bookings</small><strong><%= stats.total||0 %></strong><em>Includes demo records</em></div></article><article><span class="kpi-icon gold">＋</span><div><small>New requests</small><strong><%= stats.new_count||0 %></strong><em>Require review</em></div></article><article><span class="kpi-icon purple">₹</span><div><small>Pending quotations</small><strong><%= stats.pending_quotes||0 %></strong><em>Estimated values</em></div></article><article><span class="kpi-icon teal">✓</span><div><small>Confirmed</small><strong><%= stats.confirmed||0 %></strong><em>Scheduled requests</em></div></article><article><span class="kpi-icon green">✓</span><div><small>Completed</small><strong><%= stats.completed||0 %></strong><em>Service history</em></div></article><article><span class="kpi-icon blue">◇</span><div><small>Active technicians</small><strong><%= stats.technicians||0 %></strong><em><%= stats.services||0 %> active services</em></div></article></div><div class="chart-grid"><section class="panel"><div class="panel-head"><div><h2>Monthly bookings</h2><p>Database records by creation month</p></div><span class="demo-label">Includes demo</span></div><div class="bar-chart" data-chart><% const maxMonth=Math.max(1,...monthly.map(x=>x.count)); monthly.forEach(m=>{ %><div><span class="bar" data-value="<%= Math.round(m.count/maxMonth*100) %>"><b><%= m.count %></b></span><small><%= m.month %></small></div><% }) %></div></section><section class="panel"><div class="panel-head"><div><h2>Status distribution</h2><p>Current booking states</p></div></div><div class="horizontal-bars"><% const maxStatus=Math.max(1,...statusData.map(x=>x.count));statusData.forEach(s=>{ %><div><span><b><%= s.status %></b><em><%= s.count %></em></span><i><b data-width="<%= Math.round(s.count/maxStatus*100) %>"></b></i></div><% }) %></div></section></div><div class="admin-dashboard-grid"><section class="panel"><div class="panel-head"><div><h2>Recent bookings</h2><p>Latest database activity</p></div><a class="text-link" href="/admin/bookings">View all →</a></div><div class="table-wrap"><table><thead><tr><th>Booking</th><th>Customer</th><th>Service</th><th>Appointment</th><th>Technician</th><th>Status</th><th></th></tr></thead><tbody><% recent.forEach(b=>{ %><tr><td><strong><%= b.reference %></strong><% if(b.is_demo){ %><small>Demo record</small><% } %></td><td><%= b.customer_name %></td><td><%= b.service_name %></td><td><%= h.formatDate(b.appointment_date) %></td><td><%= b.technician_name||'Unassigned' %></td><td><span class="status-badge <%= h.statusClass(b.status) %>"><%= b.status %></span></td><td><a class="icon-button" href="/admin/bookings/<%= b.id %>">→</a></td></tr><% }) %></tbody></table></div></section><section class="panel"><div class="panel-head"><div><h2>Service demand</h2><p>Bookings by category</p></div></div><div class="category-list"><% serviceData.forEach((s,i)=>{ %><div><span class="rank"><%= i+1 %></span><strong><%= s.name %></strong><em><%= s.count %> bookings</em></div><% }) %></div></section></div><%- include('../partials/admin-footer') %>