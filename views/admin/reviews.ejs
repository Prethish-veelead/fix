<%- include('../partials/admin-header') %><div class="admin-intro"><p>Moderate real customer feedback before publication. Seeded demonstration reviews remain clearly labelled.</p></div><div class="review-admin-grid"><% reviews.forEach(r=>{ %><article class="panel review-admin-card"><div class="stars"><%= '★'.repeat(r.rating) %><%= '☆'.repeat(5-r.rating) %></div><p>“<%= r.comment %>”</p><div><strong><%= r.is_demo?'Fictional demo customer':r.name %></strong><span><%= r.service_name %> · <%= r.reference %></span><small><%= h.formatDate(r.created_at) %> <%= r.is_demo?'· Demonstration content':'' %></small></div><div class="card-actions"><form method="post" action="/admin/reviews/<%= r.id %>/toggle"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="button button-xs button-outline"><%= r.published?'Hide':'Publish' %></button></form><form method="post" action="/admin/reviews/<%= r.id %>/delete" class="confirm-form" data-confirm="Permanently remove this review?"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="button button-xs button-danger">Remove</button></form><span class="status-badge <%= r.published?'status-completed':'status-new' %>"><%= r.published?'Published':'Hidden' %></span></div></article><% }) %><% if(!reviews.length){ %><div class="empty-state"><span>☆</span><h2>No feedback yet</h2><p>Customer feedback appears after completed bookings.</p></div><% } %></div><%- include('../partials/admin-footer') %>