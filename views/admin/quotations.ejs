<%- include('../partials/admin-header') %><div class="admin-intro"><p>Create and update itemized estimates from each booking. Quotation values are not payment or revenue records.</p><span class="demo-label">Estimate management</span></div><section class="panel"><div class="table-wrap"><table><thead><tr><th>Booking</th><th>Customer</th><th>Service</th><th>Labour</th><th>Materials</th><th>Total estimate</th><th>Quotation</th><th></th></tr></thead><tbody><% rows.forEach(r=>{ %><tr><td><strong><%= r.reference %></strong><small>Booking: <%= r.booking_status %></small></td><td><%= r.customer_name %></td><td><%= r.service_name %></td><td><%= r.labour!=null?h.formatINR(r.labour):'—' %></td><td><%= r.materials!=null?h.formatINR(r.materials):'—' %></td><td><strong><%= r.total!=null?h.formatINR(r.total):'Not created' %></strong></td><td><span class="status-badge <%= r.quotation_status==='Sent'?'status-quoted':r.quotation_status==='Accepted'?'status-completed':'status-new' %>"><%= r.quotation_status||'None' %></span></td><td><a class="button button-xs button-outline" href="/admin/bookings/<%= r.booking_id %>"><%= r.total!=null?'Edit':'Create' %></a></td></tr><% }) %></tbody></table></div></section><%- include('../partials/admin-footer') %>