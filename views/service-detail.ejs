<%- include('partials/header') %><section class="detail-hero"><div class="container detail-grid"><div><a class="back-link" href="/services">← All services</a><span class="eyebrow"><%= service.category_name %></span><h1><%= service.name %></h1><p class="lead"><%= service.description %></p><div class="detail-facts"><div><small>Starting from</small><strong><%= h.formatINR(service.starting_price) %></strong><span>Illustrative price</span></div><div><small>Estimated duration</small><strong><%= service.duration %></strong><span>May vary by scope</span></div></div><a class="button button-lg" href="/book?service=<%= service.id %>">Book this service</a></div><img src="<%= service.image %>" alt="<%= service.name %> professional" width="700" height="560"></div></section><section class="section"><div class="container detail-content"><div><article class="content-card"><h2>What’s included</h2><ul class="check-list"><% service.inclusions.split('|').forEach(x=>{ %><li><span>✓</span><%= x %></li><% }) %></ul></article><article class="content-card"><h2>Before the appointment</h2><p><%= service.instructions %></p><div class="notice"><strong>Please note</strong><span><%= settings.booking_notice %></span></div></article><article class="content-card"><h2>Frequently asked questions</h2><details open><summary>Is the starting price the final amount?</summary><p>No. It is an illustrative starting point. The administrator can prepare a detailed quotation after reviewing the work required.</p></details><details><summary>When is the booking confirmed?</summary><p>Your request begins as “New.” It is confirmed only after an administrator reviews and updates it.</p></details><details><summary>Can I track the service?</summary><p>Yes. Use the booking reference and registered mobile number or sign in to the customer dashboard.</p></details></article></div><aside class="sticky-card"><span class="eyebrow">Ready to begin?</span><h3>Request <%= service.name %></h3><p>Share the issue, location and preferred appointment. No online payment is required.</p><a class="button button-block" href="/book?service=<%= service.id %>">Book now</a><a class="button button-block button-ghost" href="/contact">Ask a question</a></aside></div></section><% if(related.length){ %><section class="section section-soft"><div class="container"><div class="section-heading"><div><span class="eyebrow">You may also need</span><h2>Related services</h2></div></div><div class="service-grid"><% related.forEach(service=>{service.category_name='Related service'; %><%- include('partials/service-card',{service}) %><% }) %></div></div></section><% } %><%- include('partials/footer') %>