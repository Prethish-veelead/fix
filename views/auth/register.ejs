<%- include('../partials/header') %><section class="auth-section"><div class="container auth-layout"><div class="auth-panel"><a class="back-link" href="/">← Back to home</a><span class="eyebrow">Customer account</span><h1>Create your FixMitra account</h1><p>Book faster and keep every service request securely connected to your dashboard.</p><form method="post" novalidate><input type="hidden" name="_csrf" value="<%= csrf %>"><label class="field"><span>Full name</span><input name="name" value="<%= values.name||'' %>" autocomplete="name" required><% if(errors.name){ %><span class="field-error"><%= errors.name %></span><% } %></label><label class="field"><span>Email address</span><input type="email" name="email" value="<%= values.email||'' %>" autocomplete="email" required><% if(errors.email){ %><span class="field-error"><%= errors.email %></span><% } %></label><label class="field"><span>Mobile number</span><input name="phone" value="<%= values.phone||'' %>" inputmode="numeric" maxlength="10" autocomplete="tel" required><small>10-digit Indian mobile number</small><% if(errors.phone){ %><span class="field-error"><%= errors.phone %></span><% } %></label><label class="field"><span>Password</span><div class="password-wrap"><input type="password" name="password" minlength="10" autocomplete="new-password" required><button type="button" class="password-toggle" aria-label="Show password">Show</button></div><small>At least 10 characters</small><% if(errors.password){ %><span class="field-error"><%= errors.password %></span><% } %></label><label class="field"><span>Confirm password</span><input type="password" name="confirm" autocomplete="new-password" required><% if(errors.confirm){ %><span class="field-error"><%= errors.confirm %></span><% } %></label><button class="button button-lg button-block" type="submit">Create customer account</button></form><p class="auth-switch">Already have an account? <a href="/login">Sign in</a></p></div><div class="auth-visual"><img src="/images/service-maintenance.webp" alt="Professional home maintenance service" width="720" height="900"><div><span class="demo-label">Simple service management</span><h2>Book, track and review with confidence.</h2><p>Your customer account gives you one secure view of every request and quotation.</p></div></div></div></section><%- include('../partials/footer') %>