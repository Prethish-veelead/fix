<%- include('../partials/header') %><section class="auth-section"><div class="container auth-layout"><div class="auth-panel"><a class="back-link" href="/">← Back to home</a><span class="eyebrow"><%= admin?'Restricted administration':'Welcome back' %></span><h1><%= admin?'Administrator login':'Customer login' %></h1><p><%= admin?'Access is limited to administrator accounts created securely on the server.':'Sign in to view your bookings, appointments and status updates.' %></p><% if(error){ %><div class="form-error-banner"><%= error %></div><% } %><form method="post" action="<%= admin?'/admin/login':'/login' %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="next" value="<%= next %>"><label class="field"><span>Email address</span><input type="email" name="email" autocomplete="email" required autofocus></label><label class="field"><span>Password</span><div class="password-wrap"><input type="password" name="password" autocomplete="current-password" required><button type="button" class="password-toggle" aria-label="Show password">Show</button></div></label><button class="button button-lg button-block" type="submit">Sign in securely</button></form><% if(!admin){ %><p class="auth-switch">New to FixMitra? <a href="/register">Create a customer account</a></p><% } else { %><p class="form-footnote">There is no public administrator registration. Initial access is created with the secure setup command.</p><a class="text-link" href="/login">Customer login →</a><% } %></div><div class="auth-visual"><img src="/images/hero-technician.webp" alt="Professional FixMitra service technician" width="720" height="900"><div><span class="demo-label"><%= admin?'Role protected':'Customer portal' %></span><h2><%= admin?'Operate every service with clarity.':'Your home service history, all in one place.' %></h2><p>Secure accounts, transparent status history and professional quotation management.</p></div></div></div></section><%- include('../partials/footer') %>